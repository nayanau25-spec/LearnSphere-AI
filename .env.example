# GEMINI_API_KEY: Optional for Gemini AI Tutor calls on the server.
# AI Studio injects this automatically when configured via Secrets.
# When omitted, LearnSphere AI transparently uses its local rule-based fallback tutor.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT="3000"
